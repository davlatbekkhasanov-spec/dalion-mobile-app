# Nusxa: scripts/face-attendance-bot/.env.face-bot

# @sklad_nazoratchi_bot — BotFather token
SKLAD_BOT_TOKEN=

# Keldi/ketdi xabarlari yuboriladigan guruh yoki shaxsiy chat ID
SKLAD_NOTIFY_CHAT_ID=

# Kim buyruq yubora oladi (vergul bilan). Bo'sh qoldirsangiz — faqat NOTIFY chat
TELEGRAM_ALLOWED_CHAT_IDS=

# Boshlang'ich ro'yxat (ixtiyoriy): ism yoki ID, vergul bilan
# Masalan: Ali,Vali,101
FACE_TRACK_EMPLOYEES=

# Hikvision Face ID (faqat o'qish)
FACE_DEVICE_IP=192.168.110.50
FACE_DEVICE_USER=admin
FACE_DEVICE_PASSWORD=

POLL_INTERVAL_SEC=25
FACE_TIMEZONE=+05:00
