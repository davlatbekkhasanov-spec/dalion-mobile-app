# ============================================================
# RAILWAY / PRODUCTION — nusxa qilish uchun (alohida bo'lim)
# ============================================================
#
# MUHIM: Face ID IP (192.168.x.x) internetdan ko'rinmaydi.
# Railway faqat Telegram + web uchun. Face polling DO'KON PC da ishlashi kerak.
#
# Tavsiya: face-bot ni do'kondagi Windows da ishga tushiring (npm run face-bot).
# Railway ga faqat dalion-mobile-app (index.js) o'zgaruvchilari.
#
# Agar kelajakda VPN (Tailscale) qo'shsangiz, Railway dan ham FACE_* ishlatish mumkin.

# --- @sklad_nazoratchi_bot (do'kon PC da ishlaydigan face-bot uchun) ---
SKLAD_BOT_TOKEN=123456789:AA...botfatherdan...
SKLAD_NOTIFY_CHAT_ID=-1001234567890
TELEGRAM_ALLOWED_CHAT_IDS=-1001234567890,123456789
FACE_DEVICE_IP=192.168.110.50
FACE_DEVICE_USER=admin
FACE_DEVICE_PASSWORD=your_face_terminal_password
FACE_TRACK_EMPLOYEES=Ali,Vali
POLL_INTERVAL_SEC=25
FACE_TIMEZONE=+05:00

# --- GlobusMarket server (Railway — mavjud loyiha) ---
# DATABASE_URL=postgresql://...
# TELEGRAM_BOT_TOKEN=...boshqa bot bo'lsa...
# TELEGRAM_CHAT_ID=...
