# Application
APP_NAME=anonymous-chat
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
RUN_MODE=all

# Telegram
BOT_TOKEN=replace_with_bot_token
BOT_PARSE_MODE=HTML
BOT_USERNAME=your_bot_username

# Webhook (production on Railway — set WEBHOOK_URL to your public HTTPS domain)
WEBHOOK_URL=
WEBHOOK_SECRET=replace_with_webhook_secret

# Data layer
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/anonymous_chat
REDIS_URL=redis://redis:6379/0

# Admin panel
ADMIN_SESSION_SECRET=replace_with_long_random_secret
ADMIN_SECRET=replace_with_long_random_secret
ADMIN_BOOTSTRAP_USERNAME=owner
ADMIN_BOOTSTRAP_PASSWORD=replace_with_strong_password
ADMIN_BOOTSTRAP_ROLE=owner
OWNER_TELEGRAM_ID=

# Railway
PORT=8000
