# Application
APP_NAME=anonymous-chat
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# Telegram
BOT_TOKEN=replace_with_bot_token
BOT_PARSE_MODE=HTML

# Data layer
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/anonymous_chat
REDIS_URL=redis://redis:6379/0

# Railway-ready runtime hints
RAILWAY_ENVIRONMENT=production
PORT=8000
